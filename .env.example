# ==============================================================================
# Projeto Patas — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# ATENÇÃO: NUNCA insira chaves reais ou credenciais de produção neste arquivo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Credenciais Públicas do Supabase (Acessíveis pelo Navegador)
# ------------------------------------------------------------------------------
# URL do projeto Supabase (Ex: https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Chave Anônima Pública (Anon Key) - Segura para ser exposta no navegador sob RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# ------------------------------------------------------------------------------
# 2. Credenciais Privadas de Servidor (NUNCA expor no cliente / browser)
# ------------------------------------------------------------------------------
# Chave Service Role (Bypass de RLS) - USO RESTRITO A WEBHOOKS E ROTAS PRIVADAS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 3. Integração com Gateway de Pagamentos (Futura Etapa 3)
# ------------------------------------------------------------------------------
# Identificador e segredo de validação de assinatura do webhook do gateway
PAYMENT_GATEWAY_PROVIDER=asaas
PAYMENT_GATEWAY_API_KEY=your-payment-gateway-api-key-placeholder
PAYMENT_GATEWAY_WEBHOOK_SECRET=your-webhook-signature-secret-placeholder
